---
import AeLogo from "./AeLogo.astro";
---

<footer id="cta-footer" class="py-16 px-4 sm:px-6 relative border-t border-white/10 bg-[#07080b]">
  <div class="max-w-7xl mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10 mb-12">
      
      <!-- Brand & Tagline -->
      <div class="md:col-span-1 flex flex-col gap-4">
        <div class="flex items-center gap-3">
          <AeLogo width={36} height={24} />
          <span class="font-space text-lg font-bold text-white tracking-tight">
            Dev<span class="text-cyan-400">AE</span> Studio
          </span>
        </div>
        <p class="text-xs text-slate-300 font-light leading-relaxed">
          Estudio de Desarrollo Web & Estrategia Digital por Anderson Espinoza. Diseñamos activos digitales que atraen clientes y destacan tu marca.
        </p>
      </div>

      <!-- Navigation -->
      <div>
        <h4 class="font-mono text-xs text-cyan-400 uppercase tracking-widest font-semibold mb-4">Navegación</h4>
        <ul class="space-y-2.5 text-xs text-slate-300 font-space font-medium">
          <li><a href="#services" class="hover:text-cyan-300 transition-colors">Servicios</a></li>
          <li><a href="#tech" class="hover:text-cyan-300 transition-colors">Garantías & Calidad</a></li>
          <li><a href="#portfolio" class="hover:text-cyan-300 transition-colors">Proyectos Realizados</a></li>
          <li><a href="#pricing" class="hover:text-cyan-300 transition-colors">Planes e Inversión</a></li>
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h4 class="font-mono text-xs text-cyan-400 uppercase tracking-widest font-semibold mb-4">Contacto Directo</h4>
        <ul class="space-y-2.5 text-xs text-slate-300 font-mono">
          <li><a href="mailto:aespinozaanco38@gmail.com" class="hover:text-cyan-300 transition-colors">aespinozaanco38@gmail.com</a></li>
          <li><a href="https://wa.me/51991145635?text=Hola%20Anderson%2C%20estuve%20revisando%20tu%20sitio%20web%20DevAE%20Studio%20y%20me%20gustar%C3%ADa%20consultar%20sobre%20tus%20servicios%20de%20desarrollo%20web.%20Quedo%20atento." target="_blank" rel="noopener noreferrer" class="hover:text-emerald-300 transition-colors text-emerald-400 font-semibold">+51 991 145 635 (WhatsApp)</a></li>
          <li class="text-slate-400">Lima, Perú · Atención Global</li>
        </ul>
      </div>

      <!-- Guarantee Badge -->
      <div class="bento-card p-5 flex flex-col justify-between border border-cyan-500/20 bg-cyan-950/20">
        <div>
          <span class="text-[10px] font-mono text-emerald-400 uppercase tracking-widest block mb-1 font-semibold">✓ Compromiso DevAE</span>
          <h5 class="text-xs font-semibold text-white mb-1">Garantía de Satisfacción & Velocidad</h5>
          <p class="text-[11px] text-slate-300 font-light leading-relaxed">Entregamos tu proyecto 100% optimizado para celulares y computadoras con asesoría continua.</p>
        </div>
      </div>

    </div>

    <div class="flex flex-col sm:flex-row justify-between items-center gap-4 pt-8 border-t border-white/10 text-xs text-slate-400 font-mono">
      <span>&copy; 2026 DevAE Studio · Anderson Espinoza. Todos los derechos reservados.</span>
      <div class="flex gap-6 text-[11px]">
        <a href="#contact" class="hover:text-cyan-300 transition-colors">Consulta Gratuita</a>
        <a href="#portfolio" class="hover:text-cyan-300 transition-colors">Ver Trabajos</a>
      </div>
    </div>
  </div>
</footer>


