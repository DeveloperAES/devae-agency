---
interface Props {
  size?: number;
  class?: string;
}

const { size = 36, class: className = "" } = Astro.props;
---

<div class={`inline-flex items-center justify-center p-2 rounded-2xl bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 backdrop-blur-md shadow-lg shadow-cyan-500/10 ${className}`}>
  <svg
    width={size}
    height={size}
    viewBox="0 0 36 36"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-label="DevAE Cyber Cat Mascot"
  >
    <defs>
      <linearGradient id="cat-grad" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#00f2fe" />
        <stop offset="100%" stop-color="#fda085" />
      </linearGradient>
    </defs>

    <!-- Pointy Cat Ears -->
    <path d="M7 16L10 6L16 12" fill="url(#cat-grad)" stroke="#00f2fe" stroke-width="1.2" />
    <path d="M29 16L26 6L20 12" fill="url(#cat-grad)" stroke="#00f2fe" stroke-width="1.2" />

    <!-- Cat Head Shape -->
    <path
      d="M18 10C11.5 10 7 14.5 7 20C7 26.5 12 30 18 30C24 30 29 26.5 29 20C29 14.5 24.5 10 18 10Z"
      fill="#0a0b0e"
      stroke="#00f2fe"
      stroke-width="1.8"
    />

    <!-- Glowing Cyber Goggles / Almond Eyes -->
    <path d="M10 19C11.5 16.5 15 16.5 16.5 19C15 21.5 11.5 21.5 10 19Z" fill="#00f2fe" />
    <path d="M26 19C24.5 16.5 21 16.5 19.5 19C21 21.5 24.5 21.5 26 19Z" fill="#00f2fe" />
    
    <!-- Slit Pupils -->
    <ellipse cx="13.2" cy="19" rx="0.9" ry="2" fill="#0a0b0e" />
    <ellipse cx="22.8" cy="19" rx="0.9" ry="2" fill="#0a0b0e" />

    <!-- Cute Nose & Whiskers -->
    <path d="M18 22L16.8 23.5H19.2L18 22Z" fill="#fda085" />
    <path d="M5 19H2M5 22H1M31 19H34M31 22H35" stroke="rgba(0, 242, 254, 0.6)" stroke-width="1.2" stroke-linecap="round" />
  </svg>
</div>
