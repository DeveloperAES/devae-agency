---
import Icon from "./Icon.astro";

const valuePillars = [
  {
    category: "Velocidad & Carga Instantánea",
    badge: "Google Performance",
    description: "Una web rápida evita la pérdida de clientes y mejora tu presencia en Google.",
    items: [
      { name: "Respuesta Inmediata", desc: "La web carga en menos de 1 segundo", tag: "< 1.0s" },
      { name: "Premio en Buscadores", desc: "Google prioriza tu sitio sobre la competencia", tag: "SEO" },
      { name: "Sin Esperas en Celulares", desc: "Optimizado para navegación móvil fluida", tag: "Mobile" },
    ]
  },
  {
    category: "Diseño Único & Adaptable",
    badge: "Experiencia Premium",
    description: "Interfaces limpias y atractivas desarrolladas a la medida de tu identidad de marca.",
    items: [
      { name: "Identidad Exclusiva", desc: "Sin plantillas genéricas o repetidas", tag: "Visual" },
      { name: "Navegación Intuitiva", desc: "El cliente encuentra lo que busca en 2 clics", tag: "UX" },
      { name: "Adaptable a Pantallas", desc: "Visualización perfecta en cualquier celular", tag: "Responsive" },
    ]
  },
  {
    category: "Autogestión & Seguridad",
    badge: "100% Autonomía",
    description: "Administra tu contenido con total libertad y tranquilidad técnica.",
    items: [
      { name: "Panel de Control Fácil", desc: "Edita textos, fotos y productos sin código", tag: "CMS" },
      { name: "Seguridad Garantizada", desc: "Certificados de conexión segura SSL incluidos", tag: "SSL" },
      { name: "Capacitación Incluida", desc: "Tutoriales en video paso a paso para tu equipo", tag: "Soporte" },
    ]
  }
];
---

<section id="tech" class="py-24 lg:py-32 px-4 sm:px-6 relative overflow-hidden">
  <div class="max-w-7xl mx-auto">
    
    <!-- Section Header -->
    <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6 mb-16">
      <div class="flex flex-col gap-3 max-w-2xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-purple-500/10 border border-purple-500/20 text-xs font-mono text-purple-300 w-fit">
          <span>// POR QUÉ ELEGIRNOS</span>
        </div>
        <h2 class="font-space text-3xl sm:text-5xl font-bold text-white tracking-tight">
          Estándares diseñados para tu <span class="gradient-text-purple">tranquilidad y crecimiento</span>.
        </h2>
      </div>
      <p class="text-sm text-gray-400 font-light max-w-md">
        Desarrollamos sitios web con los más altos estándares de velocidad, seguridad y diseño profesional para que tu negocio transmita confianza desde el primer clic.
      </p>
    </div>

    <!-- Value Pillars Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      {valuePillars.map((cat) => (
        <div class="bento-card p-8 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-xs font-mono px-2.5 py-1 rounded-md bg-white/5 border border-white/10 text-cyan-300">
                {cat.badge}
              </span>
              <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
            </div>
            <h3 class="font-space text-xl font-bold text-white mb-2">{cat.category}</h3>
            <p class="text-xs text-gray-400 font-light mb-6 leading-relaxed">{cat.description}</p>
            
            <!-- Pillar Items List -->
            <div class="space-y-3">
              {cat.items.map((item) => (
                <div class="p-3.5 rounded-xl bg-white/[0.03] border border-white/5 hover:border-cyan-500/30 transition-colors flex items-center justify-between">
                  <div>
                    <h4 class="text-xs font-semibold text-white font-space">{item.name}</h4>
                    <p class="text-[11px] text-gray-400 font-light">{item.desc}</p>
                  </div>
                  <span class="text-[9px] font-mono uppercase px-2 py-0.5 rounded bg-white/5 text-gray-400">
                    {item.tag}
                  </span>
                </div>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>


