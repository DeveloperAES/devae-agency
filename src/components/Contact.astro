---
import Icon from "./Icon.astro";
import AeLogoBg from "./AeLogoBg.astro";
---

<section id="contact" class="py-24 lg:py-32 px-4 sm:px-6 relative overflow-hidden">
  <div class="max-w-7xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      
      <!-- Contact Info Sidebar (5 cols) -->
      <div class="lg:col-span-5 flex flex-col gap-8">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-xs font-mono text-cyan-400 w-fit">
          <span>// INICIAR PROYECTO</span>
        </div>

        <h2 class="font-space text-4xl sm:text-5xl lg:text-6xl font-bold text-white tracking-tight leading-tight">
          Hablemos de tu <span class="gradient-text-cyan">próximo nivel</span>.
        </h2>

        <p class="text-sm text-gray-400 font-light leading-relaxed">
          ¿Tienes un proyecto en mente o buscas un socio de ingeniería web para tu agenciar? Agenda una llamada de valoración o completa el formulario para recibir una propuesta en menos de 24h.
        </p>

        <div class="space-y-4 pt-4 border-t border-white/10">
          <div class="bento-card p-4 flex items-center gap-4">
            <div class="w-10 h-10 rounded-lg bg-cyan-500/10 border border-cyan-500/20 flex items-center justify-center text-cyan-400">
              <Icon name="Mail" class="w-5 h-5" />
            </div>
            <div>
              <span class="text-[10px] font-mono text-gray-400 uppercase tracking-widest block">Email Directo</span>
              <a href="mailto:aespinozaanco38@gmail.com" class="text-sm font-semibold text-white hover:text-cyan-300 transition-colors font-mono">
                aespinozaanco38@gmail.com
              </a>
            </div>
          </div>

          <div class="bento-card p-4 flex items-center gap-4">
            <div class="w-10 h-10 rounded-lg bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400">
              <Icon name="MessageSquare" class="w-5 h-5" />
            </div>
            <div>
              <span class="text-[10px] font-mono text-gray-400 uppercase tracking-widest block">WhatsApp / Asesoría Rápida</span>
              <a href="https://wa.me/51991145635?text=Hola%20DevAE,%20quiero%20cotizar%20un%20proyecto." target="_blank" rel="noopener noreferrer" class="text-sm font-semibold text-white hover:text-emerald-300 transition-colors font-mono">
                +51 991 145 635
              </a>
            </div>
          </div>
        </div>

      </div>

      <!-- Contact Form Container (7 cols) -->
      <div class="lg:col-span-7 bento-card p-8 lg:p-10">
        <form id="contact-form" method="POST" action="/api/contact" class="space-y-6">
          
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div>
              <label for="name" class="block text-xs font-mono text-gray-300 mb-2">Nombre / Empresa *</label>
              <input type="text" id="name" name="name" class="contact-input" placeholder="Ej. Carlos Mendoza" required />
            </div>
            <div>
              <label for="email" class="block text-xs font-mono text-gray-300 mb-2">Correo Corporativo *</label>
              <input type="email" id="email" name="email" class="contact-input" placeholder="carlos@empresa.com" required />
            </div>
          </div>

          <div>
            <label for="project" class="block text-xs font-mono text-gray-300 mb-2">Tipo de Proyecto *</label>
            <select id="project" name="project" class="contact-input" required>
              <option value="" disabled selected>Selecciona una opción</option>
              <option value="landing">Landing Page / Sprint MVP</option>
              <option value="webapp">Aplicación Web / Plataforma Custom</option>
              <option value="ecommerce">Tienda Online / E-Commerce</option>
              <option value="whitelabel">Asociación White-Label para Agencia</option>
              <option value="otro">Otro Requerimiento</option>
            </select>
          </div>

          <div>
            <label class="block text-xs font-mono text-gray-300 mb-2">Presupuesto Estimado</label>
            <div class="grid grid-cols-2 sm:grid-cols-3 gap-3" id="budget-options">
              <label class="px-3.5 py-2.5 rounded-lg border border-white/10 text-xs font-mono text-gray-300 cursor-pointer hover:border-cyan-500/40 text-center transition-colors flex items-center justify-center gap-1">
                <input type="radio" name="budget" value="S/ 790 - S/ 1,500" class="hidden" />
                <span>S/ 790 – 1.5K</span>
              </label>
              <label class="px-3.5 py-2.5 rounded-lg border border-white/10 text-xs font-mono text-gray-300 cursor-pointer hover:border-cyan-500/40 text-center transition-colors flex items-center justify-center gap-1">
                <input type="radio" name="budget" value="S/ 1,500 - S/ 3,500" class="hidden" />
                <span>S/ 1.5K – 3.5K</span>
              </label>
              <label class="px-3.5 py-2.5 rounded-lg border border-white/10 text-xs font-mono text-gray-300 cursor-pointer hover:border-cyan-500/40 text-center transition-colors flex items-center justify-center gap-1 col-span-2 sm:col-span-1">
                <input type="radio" name="budget" value="S/ 3,500+" class="hidden" />
                <span>S/ 3.5K+ / Retainer</span>
              </label>
            </div>
          </div>

          <div>
            <label for="message" class="block text-xs font-mono text-gray-300 mb-2">Detalles del Proyecto *</label>
            <textarea id="message" name="message" rows="4" class="contact-input resize-none" placeholder="Describe brevemente tus objetivos, referencias o plazos requeridos..." required></textarea>
          </div>

          <button
            type="submit"
            id="submit-btn"
            class="btn-primary w-full py-4 text-sm font-semibold tracking-wide flex items-center justify-center gap-2"
          >
            <span>Enviar Solicitud de Cotización</span>
            <Icon name="ArrowRight" class="w-4 h-4" />
          </button>

          <!-- Feedback messages -->
          <div id="form-success" class="hidden p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs font-mono text-center">
            ✔ ¡Mensaje enviado con éxito! Te contactaremos en menos de 24 horas.
          </div>
          <div id="form-error" class="hidden p-4 rounded-xl bg-red-500/10 border border-red-500/30 text-red-400 text-xs font-mono text-center">
            ✖ Ocurrió un error al enviar. Por favor intenta de nuevo o escríbenos directamente por WhatsApp.
          </div>

        </form>
      </div>

    </div>
  </div>
</section>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const budgetOptions = document.querySelectorAll("#budget-options label");

  budgetOptions.forEach((label) => {
    const input = label.querySelector("input");
    input?.addEventListener("change", () => {
      budgetOptions.forEach((l) => l.classList.remove("border-cyan-500", "bg-cyan-500/10", "text-cyan-300"));
      if (input.checked) {
        label.classList.add("border-cyan-500", "bg-cyan-500/10", "text-cyan-300");
      }
    });
  });

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement | null;
    const successEl = document.getElementById("form-success");
    const errorEl = document.getElementById("form-error");

    if (!submitBtn) return;
    submitBtn.disabled = true;
    submitBtn.style.opacity = "0.6";

    try {
      const formData = new FormData(form);
      const data = Object.fromEntries(formData.entries());

      const response = await fetch("/api/contact", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(data),
      });

      if (response.ok) {
        successEl?.classList.remove("hidden");
        errorEl?.classList.add("hidden");
        form.reset();
        budgetOptions.forEach((l) => l.classList.remove("border-cyan-500", "bg-cyan-500/10", "text-cyan-300"));
      } else {
        errorEl?.classList.remove("hidden");
        successEl?.classList.add("hidden");
      }
    } catch {
      errorEl?.classList.remove("hidden");
      successEl?.classList.add("hidden");
    } finally {
      submitBtn.disabled = false;
      submitBtn.style.opacity = "1";
    }
  });
</script>

