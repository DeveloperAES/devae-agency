---
import Icon from "./Icon.astro";
import AeLogoBg from "./AeLogoBg.astro";
---

<section
  id="contact"
  class="py-24 lg:py-32 px-4 sm:px-6 relative overflow-hidden"
>
  <div class="max-w-7xl mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      <!-- Contact Info Sidebar (5 cols) -->
      <div class="lg:col-span-5 flex flex-col gap-8">
        <div
          class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-xs font-mono text-cyan-400 w-fit"
        >
          <span>// INICIAR PROYECTO</span>
        </div>

        <h2
          class="font-space text-4xl sm:text-5xl lg:text-6xl font-bold text-white tracking-tight leading-tight"
        >
          Hablemos de tu <span class="gradient-text-cyan">próximo nivel</span>.
        </h2>

        <p class="text-sm text-gray-400 font-light leading-relaxed">
          ¿Tienes un proyecto en mente o buscas un socio de ingeniería web para
          tu agencia? Agenda una llamada de valoración o completa el formulario
          para recibir una propuesta en menos de 24h.
        </p>

        <div class="space-y-4 pt-4 border-t border-white/10">
          <div class="bento-card p-4 flex items-center gap-4">
            <div
              class="w-10 h-10 rounded-lg bg-cyan-500/10 border border-cyan-500/20 flex items-center justify-center text-cyan-400"
            >
              <Icon name="Mail" class="w-5 h-5" />
            </div>
            <div>
              <span
                class="text-[10px] font-mono text-gray-400 uppercase tracking-widest block"
                >Email Directo</span
              >
              <a
                href="mailto:aespinozaanco38@gmail.com"
                class="text-sm font-semibold text-white hover:text-cyan-300 transition-colors font-mono"
              >
                aespinozaanco38@gmail.com
              </a>
            </div>
          </div>

          <div class="bento-card p-4 flex items-center gap-4">
            <div
              class="w-10 h-10 rounded-lg bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400"
            >
              <Icon name="MessageSquare" class="w-5 h-5" />
            </div>
            <div>
              <span
                class="text-[10px] font-mono text-gray-400 uppercase tracking-widest block"
                >WhatsApp / Asesoría Rápida</span
              >
              <a
                href="https://wa.me/51991145635?text=Hola%20Anderson%2C%20estuve%20revisando%20tu%20portafolio%20en%20DevAE%20Studio%20y%20me%20gustar%C3%ADa%20consultar%20sobre%20la%20disponibilidad%20para%20desarrollar%20un%20proyecto%20web.%20Quedo%20atento."
                target="_blank"
                rel="noopener noreferrer"
                class="text-sm font-semibold text-white hover:text-emerald-300 transition-colors font-mono"
              >
                +51 991 145 635
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Contact Form Container (7 cols) -->
      <div class="lg:col-span-7 bento-card p-8 lg:p-10">
        <form
          id="contact-form"
          method="POST"
          action="/api/contact"
          class="space-y-6"
        >
          <!-- Honeypot anti-spam field (Oculto para humanos) -->
          <div class="hidden" aria-hidden="true">
            <label for="website_url">No llenar este campo</label>
            <input type="text" id="website_url" name="website_url" tabindex="-1" autocomplete="off" />
            <input type="hidden" id="form_timestamp" name="form_timestamp" value="" />
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div>
              <label
                for="name"
                class="block text-xs font-mono text-gray-300 mb-2"
                >Nombre / Empresa *</label
              >
              <input
                type="text"
                id="name"
                name="name"
                class="contact-input"
                placeholder="Ej. Carlos Mendoza"
                required
              />
            </div>
            <div>
              <label
                for="email"
                class="block text-xs font-mono text-gray-300 mb-2"
                >Correo Corporativo *</label
              >
              <input
                type="email"
                id="email"
                name="email"
                class="contact-input"
                placeholder="carlos@empresa.com"
                required
              />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div>
              <label
                for="phone"
                class="block text-xs font-mono text-gray-300 mb-2"
                >Teléfono / WhatsApp *</label
              >
              <input
                type="tel"
                id="phone"
                name="phone"
                class="contact-input"
                placeholder="+51 999 888 777"
                required
              />
            </div>
            <div>
              <label
                for="country"
                class="block text-xs font-mono text-gray-300 mb-2"
                >País *</label
              >
              <select id="country" name="country" class="contact-input" required>
                <option value="" disabled selected class="bg-[#12141f] text-slate-400">Selecciona tu país</option>
                <option value="Perú" class="bg-[#12141f] text-slate-100 py-2">🇵🇪 Perú</option>
                <option value="México" class="bg-[#12141f] text-slate-100 py-2">🇲🇽 México</option>
                <option value="Colombia" class="bg-[#12141f] text-slate-100 py-2">🇨🇴 Colombia</option>
                <option value="Chile" class="bg-[#12141f] text-slate-100 py-2">🇨🇱 Chile</option>
                <option value="Argentina" class="bg-[#12141f] text-slate-100 py-2">🇦🇷 Argentina</option>
                <option value="España" class="bg-[#12141f] text-slate-100 py-2">🇪🇸 España</option>
                <option value="Estados Unidos" class="bg-[#12141f] text-slate-100 py-2">🇺🇸 Estados Unidos</option>
                <option value="Ecuador" class="bg-[#12141f] text-slate-100 py-2">🇪🇨 Ecuador</option>
                <option value="Bolivia" class="bg-[#12141f] text-slate-100 py-2">🇧🇴 Bolivia</option>
                <option value="Costa Rica" class="bg-[#12141f] text-slate-100 py-2">🇨🇷 Costa Rica</option>
                <option value="Panamá" class="bg-[#12141f] text-slate-100 py-2">🇵🇦 Panamá</option>
                <option value="Guatemala" class="bg-[#12141f] text-slate-100 py-2">🇬🇹 Guatemala</option>
                <option value="Uruguay" class="bg-[#12141f] text-slate-100 py-2">🇺🇾 Uruguay</option>
                <option value="Otro" class="bg-[#12141f] text-slate-100 py-2">🌐 Otro país</option>
              </select>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div>
              <label
                for="city"
                class="block text-xs font-mono text-gray-300 mb-2"
                >Ciudad / Región</label
              >
              <input
                type="text"
                id="city"
                name="city"
                class="contact-input"
                placeholder="Ej. Lima, CDMX, Madrid..."
              />
            </div>
            <div>
              <label
                for="project"
                class="block text-xs font-mono text-gray-300 mb-2"
                >Tipo de Proyecto *</label
              >
              <select id="project" name="project" class="contact-input" required>
                <option value="" disabled selected class="bg-[#12141f] text-slate-400">Selecciona una opción</option>
                <option value="landing" class="bg-[#12141f] text-slate-100 py-2">Landing Page Vendedora</option>
                <option value="webapp" class="bg-[#12141f] text-slate-100 py-2">Sitio Web o Tienda Online</option>
                <option value="ecommerce" class="bg-[#12141f] text-slate-100 py-2">Sistema o Web a Medida</option>
                <option value="whitelabel" class="bg-[#12141f] text-slate-100 py-2">Asociación White-Label para Agencia</option>
                <option value="otro" class="bg-[#12141f] text-slate-100 py-2">Otro Requerimiento Especial</option>
              </select>
            </div>
          </div>

          <div>
            <label class="block text-xs font-mono text-gray-300 mb-2"
              >Presupuesto Estimado</label
            >
            <div
              class="grid grid-cols-2 sm:grid-cols-3 gap-3"
              id="budget-options"
            >
              <label
                class="px-3.5 py-2.5 rounded-lg border border-white/10 text-xs font-mono text-gray-300 cursor-pointer hover:border-cyan-500/40 text-center transition-colors flex items-center justify-center gap-1"
              >
                <input
                  type="radio"
                  name="budget"
                  value="S/ 550 - S/ 1,100"
                  class="hidden"
                />
                <span>S/ 790 – 1.5K</span>
              </label>
              <label
                class="px-3.5 py-2.5 rounded-lg border border-white/10 text-xs font-mono text-gray-300 cursor-pointer hover:border-cyan-500/40 text-center transition-colors flex items-center justify-center gap-1"
              >
                <input
                  type="radio"
                  name="budget"
                  value="S/ 1,100 - S/ 1,500"
                  class="hidden"
                />
                <span>S/ 1.1K – 1.5K</span>
              </label>
              <label
                class="px-3.5 py-2.5 rounded-lg border border-white/10 text-xs font-mono text-gray-300 cursor-pointer hover:border-cyan-500/40 text-center transition-colors flex items-center justify-center gap-1 col-span-2 sm:col-span-1"
              >
                <input
                  type="radio"
                  name="budget"
                  value="S/ 1,500+"
                  class="hidden"
                />
                <span>S/ 1.5K+ / Retainer</span>
              </label>
            </div>
          </div>

          <div>
            <label
              for="message"
              class="block text-xs font-mono text-gray-300 mb-2"
              >Detalles del Proyecto *</label
            >
            <textarea
              id="message"
              name="message"
              rows="4"
              class="contact-input resize-none"
              placeholder="Describe brevemente tus objetivos, referencias o plazos requeridos..."
              required></textarea>
          </div>

          <!-- Captcha Anti-Spam Widget -->
          <div class="p-4 rounded-xl bg-white/[0.03] border border-cyan-500/20 backdrop-blur-sm space-y-3">
            <div class="flex items-center justify-between">
              <label for="captcha_answer" class="text-xs font-mono text-cyan-400 flex items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-cyan-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                <span>Seguridad Anti-Spam (Captcha) *</span>
              </label>
              <button type="button" id="refresh-captcha-btn" class="text-[11px] font-mono text-gray-400 hover:text-cyan-300 transition-colors flex items-center gap-1 cursor-pointer">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/><path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"/><path d="M16 16h5v5"/></svg>
                <span>Nuevo desafío</span>
              </button>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-12 gap-3 items-center">
              <div class="sm:col-span-6 px-4 py-3 rounded-lg bg-[#0d101a] border border-cyan-500/30 text-center font-mono text-cyan-300 text-sm font-semibold tracking-wider select-none shadow-inner flex items-center justify-center gap-2">
                <span class="text-xs text-gray-400">Calcula:</span>
                <span id="captcha-question">Cargando...</span>
              </div>
              <div class="sm:col-span-6">
                <input
                  type="number"
                  id="captcha_answer"
                  name="captcha_answer"
                  class="contact-input text-center font-mono font-semibold"
                  placeholder="Tu respuesta"
                  required
                />
              </div>
            </div>
            <input type="hidden" id="captcha_token" name="captcha_token" value="" />
          </div>

          <button
            type="submit"
            id="submit-btn"
            class="btn-primary w-full py-4 text-sm font-semibold tracking-wide flex items-center justify-center gap-2"
          >
            <span>Enviar Solicitud de Cotización</span>
            <Icon name="ArrowRight" class="w-4 h-4" />
          </button>

          <!-- Feedback messages -->
          <div
            id="form-success"
            class="hidden p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs font-mono text-center"
          >
            ✔ ¡Mensaje enviado con éxito! Te contactaremos en menos de 24 horas.
          </div>
          <div
            id="form-error"
            class="hidden p-4 rounded-xl bg-red-500/10 border border-red-500/30 text-red-400 text-xs font-mono text-center"
          >
            ✖ Ocurrió un error al enviar. Por favor intenta de nuevo o
            escríbenos directamente por WhatsApp.
          </div>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById(
    "contact-form",
  ) as HTMLFormElement | null;
  const budgetOptions = document.querySelectorAll("#budget-options label");

  // Captcha Generator & Anti-Spam timestamp
  let numA = 0;
  let numB = 0;

  function generateCaptcha() {
    numA = Math.floor(Math.random() * 12) + 3;
    numB = Math.floor(Math.random() * 9) + 2;
    const questionEl = document.getElementById("captcha-question");
    const tokenEl = document.getElementById("captcha_token") as HTMLInputElement | null;
    const answerEl = document.getElementById("captcha_answer") as HTMLInputElement | null;

    if (questionEl) {
      questionEl.textContent = `${numA} + ${numB} = ?`;
    }
    if (tokenEl) {
      tokenEl.value = btoa(`${numA}:${numB}:${numA + numB}`);
    }
    if (answerEl) {
      answerEl.value = "";
    }
  }

  // Initialize timestamp & captcha
  const timestampEl = document.getElementById("form_timestamp") as HTMLInputElement | null;
  if (timestampEl) {
    timestampEl.value = Date.now().toString();
  }
  generateCaptcha();

  document.getElementById("refresh-captcha-btn")?.addEventListener("click", generateCaptcha);

  budgetOptions.forEach((label) => {
    const input = label.querySelector("input");
    input?.addEventListener("change", () => {
      budgetOptions.forEach((l) =>
        l.classList.remove(
          "border-cyan-500",
          "bg-cyan-500/10",
          "text-cyan-300",
        ),
      );
      if (input.checked) {
        label.classList.add(
          "border-cyan-500",
          "bg-cyan-500/10",
          "text-cyan-300",
        );
      }
    });
  });

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const submitBtn = document.getElementById(
      "submit-btn",
    ) as HTMLButtonElement | null;
    const successEl = document.getElementById("form-success");
    const errorEl = document.getElementById("form-error");

    if (!submitBtn) return;
    submitBtn.disabled = true;
    submitBtn.style.opacity = "0.6";

    try {
      const formData = new FormData(form);
      const data = Object.fromEntries(formData.entries());

      const response = await fetch("/api/contact", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(data),
      });

      const result = await response.json().catch(() => ({}));

      if (response.ok) {
        successEl?.classList.remove("hidden");
        errorEl?.classList.add("hidden");
        form.reset();
        generateCaptcha();
        budgetOptions.forEach((l) =>
          l.classList.remove(
            "border-cyan-500",
            "bg-cyan-500/10",
            "text-cyan-300",
          ),
        );
      } else {
        if (errorEl) {
          errorEl.textContent = result.error
            ? `✖ ${result.error}`
            : "✖ Ocurrió un error al enviar. Por favor intenta de nuevo o escríbenos por WhatsApp.";
          errorEl.classList.remove("hidden");
        }
        successEl?.classList.add("hidden");
        generateCaptcha();
      }
    } catch {
      if (errorEl) {
        errorEl.textContent = "✖ Ocurrió un error al enviar. Por favor intenta de nuevo o escríbenos por WhatsApp.";
        errorEl.classList.remove("hidden");
      }
      successEl?.classList.add("hidden");
      generateCaptcha();
    } finally {
      submitBtn.disabled = false;
      submitBtn.style.opacity = "1";
    }
  });
</script>
