---
import Icon from "./Icon.astro";

const projects = [
  {
    id: 1,
    title: "Ysique Store",
    client: "E-Commerce de Moda & Retail",
    category: "E-commerce",
    tags: ["Tienda Online", "Pagos con Tarjeta", "+140% Ventas Directas"],
    image: "/projects/ysique.png",
    wide: true,
    aspect: "aspect-[16/9]",
    link: "https://ysique.com/",
    status: "EN VIVO",
    impact: "Optimizó la velocidad de carga e incrementó las ventas en línea."
  },
  {
    id: 2,
    title: "OIG Perú",
    client: "Portal Corporativo & Institucional",
    category: "Corporativo",
    tags: ["Sitio Corporativo", "Diseño Exclusivo", "Posicionado en Google"],
    image: "/projects/oigperu.png",
    wide: false,
    aspect: "aspect-[4/3]",
    link: "https://oigperu.com.pe/",
    status: "EN VIVO",
    impact: "Posicionamiento institucional y generación constante de contactos."
  },
  {
    id: 3,
    title: "Olva Tracking Platform",
    client: "Sistema Logístico & Control de Envíos",
    category: "Sistema",
    tags: ["Sistema de Envíos", "Rastreo en Tiempo Real", "Portal de Clientes"],
    image: "/projects/andersonv9.png",
    wide: false,
    aspect: "aspect-[4/3]",
    link: "https://www.olvacourier.com/",
    status: "EN VIVO",
    impact: "Automatizó las consultas de envíos y rastreo de paquetes."
  },
  {
    id: 4,
    title: "Olva Tracking",
    client: "Plataforma de seguimiento de envios",
    category: "En Desarrollo",
    tags: ["Sistema Logístico", "Rastreo en Tiempo Real", "Portal de Clientes"],
    image: "/projects/tracking.png",
    wide: true,
    aspect: "aspect-[16/9]",
    link: "#",
    status: "PRÓXIMAMENTE",
    impact: "Plataforma de seguimiento de envíos para Olva Courier."
  },
];
---

<section id="portfolio" class="py-24 lg:py-32 px-4 sm:px-6 relative">
  <div class="max-w-7xl mx-auto">
    
    <!-- Section Header & Filter Buttons -->
    <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-8 mb-16">
      <div class="flex flex-col gap-3 max-w-2xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-xs font-mono text-cyan-400 w-fit">
          <span>// CASOS DE ÉXITO & PRÓXIMOS LANZAMIENTOS</span>
        </div>
        <h2 class="font-space text-3xl sm:text-5xl font-bold text-white tracking-tight">
          Proyectos desarrollados para <span class="gradient-text-cyan">generar resultados</span>.
        </h2>
      </div>

      <!-- Filter Buttons -->
      <div class="flex flex-wrap gap-2 font-mono text-xs" id="portfolio-filters">
        <button
          data-filter="all"
          class="filter-btn px-4 py-2 rounded-full border border-cyan-500 bg-cyan-500/10 text-cyan-300 font-semibold transition-all"
        >
          Todos
        </button>
        <button
          data-filter="E-commerce"
          class="filter-btn px-4 py-2 rounded-full border border-white/15 text-slate-300 hover:border-cyan-500/50 hover:text-white transition-all"
        >
          E-Commerce
        </button>
        <button
          data-filter="Sistema"
          class="filter-btn px-4 py-2 rounded-full border border-white/15 text-slate-300 hover:border-cyan-500/50 hover:text-white transition-all"
        >
          Sistemas & APIs
        </button>
        <button
          data-filter="Corporativo"
          class="filter-btn px-4 py-2 rounded-full border border-white/15 text-slate-300 hover:border-cyan-500/50 hover:text-white transition-all"
        >
          Corporativo
        </button>
        <button
          data-filter="En Desarrollo"
          class="filter-btn px-4 py-2 rounded-full border border-purple-500/40 text-purple-300 hover:border-purple-400 hover:text-white transition-all bg-purple-500/10"
        >
          ● En Desarrollo
        </button>
      </div>
    </div>

    <!-- Portfolio Bento Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-8" id="portfolio-grid">
      {projects.map((p) => (
        <a
          href={p.link}
          target={p.link !== "#" ? "_blank" : "_self"}
          rel={p.link !== "#" ? "noopener noreferrer" : ""}
          class={`portfolio-item group block bento-card p-4 sm:p-6 transition-all duration-500 ${
            p.wide ? "lg:col-span-8" : "lg:col-span-4"
          }`}
          data-category={p.category}
        >
          <!-- Image Container with Hover Zoom -->
          <div class={`relative ${p.aspect} rounded-xl overflow-hidden bg-black/60 border border-white/10 mb-5`}>
            <img
              src={p.image}
              alt={p.title}
              class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-700 brightness-95 group-hover:brightness-100"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-60 group-hover:opacity-40 transition-opacity"></div>
            
            <div class="absolute top-4 left-4">
              <span class={`text-[10px] font-mono font-semibold px-2.5 py-1 rounded-full backdrop-blur-md border ${
                p.status === 'PRÓXIMAMENTE' 
                  ? 'bg-purple-500/20 text-purple-300 border-purple-500/30' 
                  : 'bg-emerald-500/20 text-emerald-300 border-emerald-500/30'
              }`}>
                ● {p.status}
              </span>
            </div>

            {p.link !== "#" && (
              <div class="absolute top-4 right-4 px-3 py-1 rounded-full bg-black/80 backdrop-blur-md border border-white/20 text-[11px] font-mono text-cyan-300 flex items-center gap-1.5 opacity-0 group-hover:opacity-100 transition-opacity">
                <span>Ver Sitio En Vivo</span>
                <Icon name="ArrowRight" class="w-3.5 h-3.5" />
              </div>
            )}
          </div>

          <!-- Content Details -->
          <div class="flex flex-col gap-2">
            <span class="text-xs font-mono text-cyan-400 font-semibold">{p.client}</span>
            <h3 class="font-space text-2xl font-bold text-white group-hover:text-cyan-300 transition-colors">
              {p.title}
            </h3>
            <p class="text-xs text-slate-300 font-light leading-relaxed mb-3">
              {p.impact}
            </p>

            <!-- Impact Tags -->
            <div class="flex flex-wrap gap-2 pt-2 border-t border-white/10">
              {p.tags.map((tag) => (
                <span class="text-[10px] font-mono px-2.5 py-1 rounded bg-white/10 text-slate-200 border border-white/10 font-medium">
                  {tag}
                </span>
              ))}
            </div>
          </div>
        </a>
      ))}
    </div>

  </div>
</section>

<script>
  const filterBtns = document.querySelectorAll(".filter-btn");
  const items = document.querySelectorAll(".portfolio-item");

  filterBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      const filter = btn.getAttribute("data-filter");

      filterBtns.forEach((b) => {
        if (b === btn) {
          b.classList.add("border-cyan-500", "bg-cyan-500/10", "text-cyan-300");
          b.classList.remove("border-white/10", "text-gray-400");
        } else {
          b.classList.remove("border-cyan-500", "bg-cyan-500/10", "text-cyan-300");
          b.classList.add("border-white/10", "text-gray-400");
        }
      });

      items.forEach((item) => {
        const category = item.getAttribute("data-category");
        if (filter === "all" || category === filter) {
          (item as HTMLElement).style.display = "block";
        } else {
          (item as HTMLElement).style.display = "none";
        }
      });
    });
  });
</script>

