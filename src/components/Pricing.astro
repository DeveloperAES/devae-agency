---
import Icon from "./Icon.astro";

const plans = [
  {
    name: "Landing Page Vendedora",
    badge: "Ideal para Emprendedores",
    price: "790",
    unit: "S/",
    desc: "Diseñada para captar clientes de inmediato y dirigir el tráfico directamente a llamadas o WhatsApp.",
    popular: false,
    features: [
      "Diseño Exclusivo Centrado en Ventas",
      "100% Adaptable a Celulares y Computadoras",
      "Carga Ultra Rápida Garantizada en Google",
      "Formulario de Contacto & Botón WhatsApp Directo",
      "Certificado de Seguridad SSL Gratuito",
      "Entrega Rápida en 5 a 7 días hábiles",
    ],
    waMessage: "Hola DevAE, quiero cotizar la Landing Page Vendedora.",
  },
  {
    name: "Sitio Web o Tienda Online",
    badge: "Más Solicitado por Empresas",
    price: "1,850",
    unit: "S/",
    desc: "Solución integral para marcas que buscan posicionarse con autoridad y vender productos o servicios 24/7.",
    popular: true,
    features: [
      "Diseño Profesional a Medida de tu Marca",
      "Tienda Online Completa o Portal Corporativo",
      "Panel Administrable Fácil (Modifica Fotos y Textos)",
      "Cobro Seguro con Tarjetas de Crédito y Débito",
      "Optimización de Posicionamiento en Google (SEO)",
      "Capacitación Grabada Paso a Paso Incluida",
      "Entrega en 10 a 14 días hábiles",
    ],
    waMessage: "Hola DevAE, me interesa el plan Sitio Web o Tienda Online.",
  },
  {
    name: "Sistema o Web a Medida",
    badge: "Empresas & Proyectos Especiales",
    price: "3,500",
    unit: "S/",
    desc: "Desarrollo exclusivo adaptado a los flujos de trabajo, automatizaciones e integraciones de tu empresa.",
    popular: false,
    features: [
      "Desarrollo 100% Personalizado a tu Medida",
      "Conexión con tus Herramientas de Pago y Gestión",
      "Servidores de Alta Velocidad & Seguridad Máxima",
      "Flujos de Trabajo Automatizados para tu Equipo",
      "Soporte Técnico Prioritario & Garantía Continua",
      "Acuerdo de Confidencialidad NDA Disponible",
    ],
    waMessage: "Hola DevAE, requiero cotizar un Proyecto a Medida.",
  },
];

const faqs = [
  {
    question: "¿Cómo es la modalidad de trabajo y pago?",
    answer: "Trabajamos con una inicial del 50% para arrancar el proyecto y el 50% restante contra la entrega final en servidor de prueba, previa aprobación completa.",
  },
  {
    question: "¿Qué garantía ofrecen sobre la velocidad y el código?",
    answer: "Garantizamos un puntaje mínimo de 90/100 a 100/100 en Google PageSpeed Insights. Si la web no cumple los parámetros de rendimiento acordados, ajustamos la optimización sin costo.",
  },
  {
    question: "¿Puedo administrar el contenido de mi sitio por mi cuenta?",
    answer: "Sí, todos los proyectos Pro y Enterprise incluyen capacitación grabada y paneles de administración intuitivos para que edites textos, productos e imágenes sin tocar código.",
  },
  {
    question: "¿Trabajan como marca blanca para otras agencias o empresas?",
    answer: "Absolutamente. Colaboramos frecuentemente como brazo técnico de agencias creativas y firmas de marketing firmando acuerdos de confidencialidad (NDA).",
  },
];
---

<section id="pricing" class="py-24 lg:py-32 px-4 sm:px-6 relative">
  <div class="max-w-7xl mx-auto">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-xs font-mono text-cyan-400 mb-4">
        <span>// INVERSIÓN & MODELOS DE TRABAJO</span>
      </div>
      <h2 class="font-space text-3xl sm:text-5xl font-bold text-white tracking-tight">
        Planes transparentes diseñados para <span class="gradient-text-cyan">escalar</span>.
      </h2>
      <p class="text-sm text-gray-400 font-light mt-3">
        Formatos flexibles adaptados tanto a startups que inician como a empresas y agencias consolidadas.
      </p>
    </div>

    <!-- Pricing Bento Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-stretch mb-20">
      {plans.map((p) => (
        <div
          class={`bento-card p-8 flex flex-col justify-between relative ${
            p.popular ? "border-cyan-500/60 shadow-2xl shadow-cyan-500/10 ring-1 ring-cyan-500/30" : ""
          }`}
        >
          {p.popular && (
            <span class="absolute top-3 right-4 bg-gradient-to-r from-cyan-400 to-blue-500 text-slate-950 font-space text-[10px] font-bold uppercase tracking-wider px-3 py-1 rounded-full shadow-md z-10">
              MÁS SOLICITADO
            </span>
          )}

          <div>
            <span class="text-xs font-mono text-cyan-400 block mb-2">{p.badge}</span>
            <h3 class="font-space text-2xl font-bold text-white mb-2">{p.name}</h3>
            <p class="text-xs text-gray-400 font-light leading-relaxed mb-6">{p.desc}</p>

            <!-- Price display -->
            <div class="p-4 rounded-xl bg-white/[0.03] border border-white/5 mb-6">
              <span class="text-[10px] font-mono text-cyan-400 uppercase tracking-widest block">Inversión desde</span>
              <div class="flex items-baseline gap-1 mt-1">
                <span class="text-xl font-bold font-space text-gray-400">{p.unit}</span>
                <span class="text-4xl font-bold font-space text-white">{p.price}</span>
                <span class="text-xs text-gray-400 font-mono">/ proyecto</span>
              </div>
            </div>

            <!-- Features -->
            <ul class="space-y-3 mb-8">
              {p.features.map((f) => (
                <li class="flex items-start gap-2.5 text-xs text-gray-300">
                  <Icon name="Check" class="w-4 h-4 text-cyan-400 shrink-0 mt-0.5" />
                  <span>{f}</span>
                </li>
              ))}
            </ul>
          </div>

          <a
            href={`https://wa.me/51991145635?text=${encodeURIComponent(p.waMessage)}`}
            target="_blank"
            rel="noopener noreferrer"
            class={`w-full py-3.5 rounded-full text-center font-space font-semibold text-xs tracking-wide transition-all ${
              p.popular
                ? "bg-gradient-to-r from-cyan-400 to-blue-500 text-slate-950 hover:opacity-90 shadow-lg shadow-cyan-500/20"
                : "glass-pill text-white hover:bg-white/10"
            }`}
          >
            Seleccionar Plan →
          </a>
        </div>
      ))}
    </div>

    <!-- FAQs -->
    <div class="max-w-3xl mx-auto">
      <h3 class="font-space text-2xl font-bold text-white text-center mb-8">Preguntas Frecuentes</h3>
      <div class="space-y-4">
        {faqs.map((faq) => (
          <details class="bento-card p-6 group cursor-pointer">
            <summary class="flex justify-between items-center text-sm font-semibold text-white">
              <span>{faq.question}</span>
              <Icon name="Plus" class="w-4 h-4 text-cyan-400 group-open:rotate-45 transition-transform" />
            </summary>
            <p class="mt-3 text-xs text-gray-400 leading-relaxed font-light border-t border-white/5 pt-3">
              {faq.answer}
            </p>
          </details>
        ))}
      </div>
    </div>

  </div>
</section>

