---
import Icon from "./Icon.astro";

const services = [
  {
    num: "01",
    icon: "MonitorSmartphone",
    badge: "Captación de Clientes",
    title: "Landing Pages de Alta Conversión",
    desc: "Páginas web diseñadas estratégicamente para captar leads, agendar consultas o vender servicios directamente con máxima efectividad.",
    deliverables: ["Máxima Velocidad en Celulares", "Estructura Persuasiva & CTAs", "Formulario & Botón WhatsApp Directo"],
    accent: "cyan",
    wide: true,
  },
  {
    num: "02",
    icon: "ShoppingCart",
    badge: "Ventas 24/7 Online",
    title: "Tiendas Online & E-Commerce",
    desc: "Plataformas de venta rápida y autogestionable. Integración de cobros con tarjeta, catálogo sin límite y gestión de pedidos.",
    deliverables: ["Cobro Seguro con Tarjetas", "Panel Autogestionable Fácil", "Notificaciones de Pedidos al Instante"],
    accent: "gold",
    wide: false,
  },
  {
    num: "03",
    icon: "BookOpen",
    badge: "Presencia & Autoridad",
    title: "Sitios Web Corporativos",
    desc: "Portales de marca con estética moderna y profesional que generan confianza inmediata ante tus clientes e inversionistas.",
    deliverables: ["Diseño Exclusivo Personalizado", "Posicionamiento en Google (SEO)", "Secciones Ilimitadas & Blog"],
    accent: "purple",
    wide: false,
  },
  {
    num: "04",
    icon: "Database",
    badge: "Automatización de Negocio",
    title: "Sistemas & Soluciones a Medida",
    desc: "Plataformas web avanzadas diseñadas a la medida de los flujos operacionales de tu empresa o startup.",
    deliverables: ["Integración con tus Herramientas", "Seguridad Nivel Empresarial", "Capacitación & Soporte Incluido"],
    accent: "cyan",
    wide: true,
  },
];
---

<section id="services" class="py-24 lg:py-32 px-4 sm:px-6 relative">
  <div class="max-w-7xl mx-auto">
    
    <!-- Section Header -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-end mb-16">
      <div class="lg:col-span-8 reveal-service flex flex-col gap-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-xs font-mono text-cyan-400 w-fit">
          <span>// SOLUCIONES DIGITALES</span>
        </div>
        <h2 class="font-space text-3xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-white leading-tight">
          Servicios diseñados para impulsar las <span class="gradient-text-cyan">ventas de tu negocio</span>.
        </h2>
      </div>
      <div class="lg:col-span-4 reveal-service">
        <p class="text-base text-slate-300 font-light leading-relaxed">
          Diseñamos activos estratégicos que aceleran el crecimiento de tu marca, posicionan tu negocio sobre la competencia y garantizan resultados visuales y comerciales.
        </p>
      </div>
    </div>

    <!-- Bento Grid Services -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-6">
      {services.map((s) => (
        <div
          class={`reveal-service bento-card p-8 flex flex-col justify-between group ${
            s.wide ? "lg:col-span-7" : "lg:col-span-5"
          }`}
        >
          <div>
            <!-- Top Card Header -->
            <div class="flex items-center justify-between mb-6">
              <div class={`w-12 h-12 rounded-xl flex items-center justify-center ${
                s.accent === 'gold' ? 'bg-amber-500/10 text-amber-400 border border-amber-500/20' :
                s.accent === 'purple' ? 'bg-purple-500/10 text-purple-400 border border-purple-500/20' :
                'bg-cyan-500/10 text-cyan-400 border border-cyan-500/20'
              }`}>
                <Icon name={s.icon as any} class="w-6 h-6" />
              </div>
              <span class="text-xs font-mono text-slate-400 font-semibold">{s.num}</span>
            </div>

            <!-- Badge & Title -->
            <span class="text-xs font-mono text-cyan-400 tracking-wider uppercase block mb-2">{s.badge}</span>
            <h3 class="font-space text-2xl lg:text-3xl font-bold text-white mb-3 group-hover:text-cyan-300 transition-colors">
              {s.title}
            </h3>
            <p class="text-sm text-slate-300 leading-relaxed font-light mb-6">
              {s.desc}
            </p>
          </div>

          <!-- Deliverables Checklist -->
          <div class="border-t border-white/10 pt-5 mt-2">
            <span class="text-[11px] font-mono uppercase text-slate-400 block mb-3 font-semibold">Qué Incluye Tu Proyecto:</span>
            <ul class="space-y-2">
              {s.deliverables.map((item) => (
                <li class="flex items-center gap-2 text-xs text-slate-200 font-medium">
                  <span class="w-1.5 h-1.5 rounded-full bg-cyan-400"></span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>

        </div>
      ))}
    </div>

    <!-- Agency Partnership Callout -->
    <div class="mt-8 bento-card p-8 lg:p-10 flex flex-col lg:flex-row items-start lg:items-center justify-between gap-8 bg-gradient-to-r from-cyan-950/20 via-purple-950/20 to-slate-900/60 border border-cyan-500/20">
      <div class="flex flex-col gap-2 max-w-2xl">
        <span class="text-xs font-mono text-cyan-400 uppercase tracking-widest">// ALIANZAS & PROYECTOS ESPECIALES</span>
        <h3 class="font-space text-2xl lg:text-3xl font-bold text-white">
          ¿Tienes un Proyecto o Requerimiento Especial?
        </h3>
        <p class="text-sm text-gray-300 font-light">
          Evaluamos tu proyecto de forma gratuita y te brindamos una propuesta detallada ajustada al presupuesto y tiempos de tu negocio.
        </p>
      </div>
      <a
        href="#contact"
        class="btn-primary whitespace-nowrap"
      >
        Hablar con un Especialista
      </a>
    </div>

  </div>
</section>


