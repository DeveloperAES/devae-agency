---
// Custom Cursor Component
---
<div id="custom-cursor-dot" class="custom-cursor-dot" aria-hidden="true"></div>
<div id="custom-cursor-circle" class="custom-cursor-circle" aria-hidden="true"></div>

<script>
  import { gsap } from 'gsap';

  if (window.matchMedia('(pointer: fine)').matches) {
    const cursorDot = document.getElementById('custom-cursor-dot');
    const cursorCircle = document.getElementById('custom-cursor-circle');

    if (cursorDot && cursorCircle) {
      gsap.set([cursorDot, cursorCircle], { 
        xPercent: -50, 
        yPercent: -50,
        opacity: 0 
      });

      const xToDot = gsap.quickTo(cursorDot, "x", { duration: 0.08, ease: "power3" });
      const yToDot = gsap.quickTo(cursorDot, "y", { duration: 0.08, ease: "power3" });

      const xToCircle = gsap.quickTo(cursorCircle, "x", { duration: 0.25, ease: "power2.out" });
      const yToCircle = gsap.quickTo(cursorCircle, "y", { duration: 0.25, ease: "power2.out" });

      window.addEventListener("mousemove", (e) => {
        if (gsap.getProperty(cursorDot, "opacity") === 0) {
          gsap.to([cursorDot, cursorCircle], { opacity: 1, duration: 0.3 });
        }
        xToDot(e.clientX);
        yToDot(e.clientY);
        xToCircle(e.clientX);
        yToCircle(e.clientY);
      });

      document.addEventListener("mouseleave", () => {
        gsap.to([cursorDot, cursorCircle], { opacity: 0, duration: 0.3 });
      });

      document.addEventListener("mouseenter", () => {
        gsap.to([cursorDot, cursorCircle], { opacity: 1, duration: 0.3 });
      });

      window.addEventListener("mouseover", (e) => {
        const target = e.target as HTMLElement | null;
        if (!target) return;

        const isInteractive = target.closest('a, button, [role="button"], .bento-card, .portfolio-item, summary, input, select, textarea, details');

        if (isInteractive) {
          gsap.to(cursorCircle, {
            scale: 2,
            backgroundColor: 'rgba(0, 242, 254, 0.1)',
            borderColor: 'rgba(0, 242, 254, 0.8)',
            duration: 0.25
          });
          gsap.to(cursorDot, {
            scale: 0.5,
            backgroundColor: '#ffffff',
            duration: 0.25
          });
        }
      });

      window.addEventListener("mouseout", (e) => {
        const target = e.target as HTMLElement | null;
        if (!target) return;

        const isInteractive = target.closest('a, button, [role="button"], .bento-card, .portfolio-item, summary, input, select, textarea, details');

        if (isInteractive) {
          gsap.to(cursorCircle, {
            scale: 1,
            backgroundColor: 'transparent',
            borderColor: 'rgba(0, 242, 254, 0.35)',
            duration: 0.25
          });
          gsap.to(cursorDot, {
            scale: 1,
            backgroundColor: '#00f2fe',
            duration: 0.25
          });
        }
      });
    }
  }
</script>

<style>
  @media (pointer: fine) {
    .custom-cursor-dot {
      position: fixed;
      top: 0;
      left: 0;
      width: 7px;
      height: 7px;
      background-color: #00f2fe;
      border-radius: 50%;
      pointer-events: none;
      z-index: 9999;
      box-shadow: 0 0 10px rgba(0, 242, 254, 0.8);
    }

    .custom-cursor-circle {
      position: fixed;
      top: 0;
      left: 0;
      width: 30px;
      height: 30px;
      border: 1px solid rgba(0, 242, 254, 0.35);
      background-color: transparent;
      border-radius: 50%;
      pointer-events: none;
      z-index: 9998;
      transition: background-color 0.25s, border-color 0.25s;
    }
  }
</style>

