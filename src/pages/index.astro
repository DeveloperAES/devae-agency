---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import HeroBento from "../components/HeroBento.astro";
import Services from "../components/Services.astro";
import TechLedger from "../components/TechLedger.astro";
import Portfolio from "../components/Portfolio.astro";
import Pricing from "../components/Pricing.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
import CustomCursor from "../components/CustomCursor.astro";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=3" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="DevAE Studio - Estudio de Ingeniería Web & Arquitectura Digital por Anderson Espinoza. Aplicaciones web a medida, e-commerce ultra rápido y plataformas de alta conversión."
    />
    <title>
      DevAE Studio | Estudio de Ingeniería Web & Arquitectura Digital
    </title>
  </head>
  <body class="bg-[#0a0b0e] text-slate-100 font-space selection:bg-cyan-500/30 selection:text-cyan-200">
    <Navbar />
    <main>
      <HeroBento />
      <Services />
      <TechLedger />
      <Portfolio />
      <Pricing />
      <Contact />
    </main>
    <Footer />
    <CustomCursor />

    <script>
      import { gsap } from "gsap";

      // Gentle entry animation for Hero section elements without hiding content
      if (window.innerWidth >= 768) {
        gsap.fromTo(".reveal-hero", 
          { opacity: 0.8, y: 15 },
          { opacity: 1, y: 0, duration: 0.7, stagger: 0.08, ease: "power2.out" }
        );
      }
    </script>
  </body>
</html>


