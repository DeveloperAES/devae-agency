---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import HeroBento from "../components/HeroBento.astro";
import Services from "../components/Services.astro";
import TechLedger from "../components/TechLedger.astro";
import Portfolio from "../components/Portfolio.astro";
import Pricing from "../components/Pricing.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
import CustomCursor from "../components/CustomCursor.astro";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=3" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="DevAE Studio - Estudio de Ingeniería Web & Arquitectura Digital por Anderson Espinoza. Aplicaciones web a medida, e-commerce ultra rápido y plataformas de alta conversión."
    />
    <title>
      DevAE Studio | Estudio de Ingeniería Web & Arquitectura Digital
    </title>
  </head>
  <body class="bg-[#0a0b0e] text-slate-100 font-space selection:bg-cyan-500/30 selection:text-cyan-200">
    <Navbar />
    <main>
      <HeroBento />
      <Services />
      <TechLedger />
      <Portfolio />
      <Pricing />
      <Contact />
    </main>
    <Footer />
    <CustomCursor />

    <script>
      import { gsap } from "gsap";
      import { ScrollTrigger } from "gsap/ScrollTrigger";

      gsap.registerPlugin(ScrollTrigger);

      const isMobile = window.innerWidth < 768 || window.matchMedia("(pointer: coarse)").matches;

      if (!isMobile) {
        // Desktop smooth reveals
        gsap.fromTo(".reveal-hero", 
          { opacity: 0, y: 20 },
          { opacity: 1, y: 0, duration: 0.8, stagger: 0.1, ease: "power2.out", delay: 0.1 }
        );

        ScrollTrigger.batch(".reveal-service, .portfolio-item, .bento-card", {
          start: "top 90%",
          onEnter: (batch) => {
            gsap.fromTo(batch,
              { opacity: 0, y: 25 },
              { opacity: 1, y: 0, duration: 0.6, stagger: 0.08, ease: "power2.out", overwrite: "auto" }
            );
          },
          once: true
        });
      } else {
        // Mobile phones: ensure 100% instant visibility without opacity delays
        gsap.set(".reveal-hero, .reveal-service, .portfolio-item, .bento-card", {
          opacity: 1,
          y: 0,
          clearProps: "all"
        });
      }

      // Fail-safe handler for tab switching, refresh and scroll-to-top
      const ensureVisibility = () => {
        gsap.to(".reveal-hero, .reveal-service, .portfolio-item, .bento-card", {
          opacity: 1,
          y: 0,
          duration: 0.2,
          overwrite: "auto"
        });
        ScrollTrigger.refresh();
      };

      window.addEventListener("load", ensureVisibility);
      window.addEventListener("pageshow", ensureVisibility);
      document.addEventListener("visibilitychange", () => {
        if (document.visibilityState === "visible") {
          ensureVisibility();
        }
      });
    </script>
  </body>
</html>


